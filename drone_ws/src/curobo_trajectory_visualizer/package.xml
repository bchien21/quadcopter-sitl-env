<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>curobo_trajectory_visualizer</name>
  <version>0.1.0</version>
  <description>Displays saved cuRobo trajectories in RViz.</description>
  <maintainer email="brianchien04172@gmail.com">bchien12</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>rclpy</exec_depend>
